<!DOCTYPE html>
<html lang="en">
<head>
    <%- include ('./partials/head') %>
    <title><%= blog.title %></title>
</head>
<body>
    <%- include ('./partials/nav') %>
    
    <div class="container">
        <h1><%= blog.title %></h1>
        <img style="width: 50%; height: auto;" src="<%= blog.coverImageURL %>" alt="Blog Cover Image">
        <p><%= blog.body %></p>
        <p>Written by: <%= blog.createdBy %></p>
    

        <% if (locals.user) { %>
         <form action="/blog/comment/<%= blog._id %>" method="post">
             <textarea class="form-control" name="comment" id="comment" rows="3" placeholder="Add a comment..."></textarea>
             <button class="btn btn-primary" type="submit"> Submit</button>
        </form>
        <% } %>


        <div class="mt-3">
            <% comments.forEach(comment => { %>
             <div>
            <img src="<%= comment.createdBy.profileImageURL %>" width="40px" 
            style="border:1px solid black;border-radius:50%;" alt="profile">
            <%= comment.createdBy.name %>
            <pre><%= comment.content %></pre>
             </div>
            <% }) %>
        </div>

    <%- include ('./partials/scripts') %>
</body>
    
</html>